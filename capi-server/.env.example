# Aurea CAPI — environment file (copy to /opt/aurea-capi/.env on the VPS)

META_PIXEL_ID=1255787176340976

# Generate this in Events Manager:
#   Settings → Conversions API → Generate access token
# It is a long string starting with EAA...
META_ACCESS_TOKEN=__PUT_TOKEN_HERE__

# Optional. Set to your Test Event Code while validating in
# Events Manager → Test events. Remove for production traffic.
#META_TEST_EVENT_CODE=TEST12345

CAPI_PORT=3001
CAPI_HOST=127.0.0.1
